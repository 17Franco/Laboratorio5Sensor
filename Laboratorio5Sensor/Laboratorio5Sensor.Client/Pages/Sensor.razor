@page "/sensor"
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@implements IAsyncDisposable

<h3>Sensor en tiempo real</h3>
<RadzenRadialGauge Style="width: 100%; height: 300px;">
    <RadzenRadialGaugeScale Min="0" Max="100"
                            Step="20"
                            StartAngle="-150" EndAngle="150">
        <RadzenRadialGaugeScalePointer Value="@temperaturaActual"
                                       ShowValue="true" />

        <RadzenRadialGaugeScaleRange From="0" To="40" Fill="green" />
        <RadzenRadialGaugeScaleRange From="40" To="70" Fill="orange" />
        <RadzenRadialGaugeScaleRange From="70" To="100" Fill="red" />
    </RadzenRadialGaugeScale>
</RadzenRadialGauge>

@code {
    private HubConnection? hubConnection;
    
    private double temperaturaActual = 0;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/sensorTemperatura"))
            .Build();

        hubConnection.On<int>("cambioDeTemperatura", async temperatura =>
        {
            await InvokeAsync(() =>
            {
                temperaturaActual = temperatura;
                Console.WriteLine($"Nueva temperatura: {temperatura}");
                StateHasChanged();
            });
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            
            await hubConnection.DisposeAsync();
        }
    }
}